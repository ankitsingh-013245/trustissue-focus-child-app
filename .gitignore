# Flutter and Dart generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android local configuration and generated output
android/.gradle/
android/captures/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# Signing credentials — never commit these
android/key.properties
*.jks
*.keystore
*.p12
*.pem

# IDE and operating-system files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp

# Binary artwork is reconstructed from tracked chunks by:
# dart run tools/restore_binary_assets.dart
assets/branding/*.png
assets/images/*.png
android/app/src/main/ic_launcher-playstore.png
android/app/src/main/res/drawable-*/*.png
android/app/src/main/res/mipmap-*/*.png
